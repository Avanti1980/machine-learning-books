      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>doi:10.1007/978-3-031-16174-2_8</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Springer International Publishing</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Advances in Graph Neural Networks, doi:10.1007/978-3-031-16174-2_8</rdf:li>
            </rdf:Alt>
         </dc:description>
